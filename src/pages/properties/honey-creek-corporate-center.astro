---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import LeadCaptureForm from '../../components/LeadCaptureForm.astro';
import PropertyGallery from '../../components/PropertyGallery.astro';
import PropertyMap from '../../components/PropertyMap.astro';
---

<Layout title="Honey Creek Corporate Center – Blackdeer Investment Group">
  <Nav />

  <main class="pt-[68px]">
    <!-- Hero Image -->
    <section class="relative h-[360px] overflow-hidden">
      <img src="/images/properties/honey-creek/panoramic.jpg" alt="Honey Creek Corporate Center" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-black/25"></div>
      <div class="absolute inset-0 flex items-end">
        <div class="max-w-[1280px] mx-auto px-10 pb-10 w-full">
          <div class="flex flex-col items-start gap-2">
            <span class="bg-black/80 text-white text-[11px] tracking-[.14em] uppercase font-semibold px-3 py-1.5 inline-block">Commercial · Managed</span>
            <span class="bg-black/80 text-white text-[clamp(28px,3.5vw,44px)] font-bold tracking-tight px-4 py-2 inline-block leading-tight">Honey Creek Corporate Center</span>
            <span class="bg-black/80 text-white text-[15px] px-3 py-1.5 inline-block">Madison, WI</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Content -->
    <section class="bg-white py-16 border-t border-border">
      <div class="max-w-[1280px] mx-auto px-10">
        <div class="col-2 grid grid-cols-2 gap-16 items-start">

          <div>
            <div class="accent-rule"></div>
            <h2 class="text-[24px] font-bold text-black mb-4">Property Overview</h2>
            <p class="text-[14px] text-mid-gray leading-[1.8] mb-6">Honey Creek Corporate Center is a premier multi-tenant office campus located in Madison, Wisconsin. Set in a park-like environment with mature landscaping, walking paths, and a signature pond, the property offers a professional yet relaxed setting ideal for professional services, technology, and financial firms.</p>

            <div class="grid grid-cols-2 gap-4 mb-8">
              <div class="p-4 bg-off-white border border-border">
                <div class="text-[10px] tracking-[.14em] uppercase text-mid-gray mb-1">Asset Type</div>
                <div class="text-[14px] font-semibold text-black">Multi-Tenant Office</div>
              </div>
              <div class="p-4 bg-off-white border border-border">
                <div class="text-[10px] tracking-[.14em] uppercase text-mid-gray mb-1">Location</div>
                <div class="text-[14px] font-semibold text-black">Madison, WI</div>
              </div>
              <div class="p-4 bg-off-white border border-border">
                <div class="text-[10px] tracking-[.14em] uppercase text-mid-gray mb-1">Management</div>
                <div class="text-[14px] font-semibold text-black">Blackdeer Investment Group</div>
              </div>
              <div class="p-4 bg-off-white border border-border">
                <div class="text-[10px] tracking-[.14em] uppercase text-mid-gray mb-1">Status</div>
                <div class="text-[14px] font-semibold text-black">Active · Leasing</div>
              </div>
            </div>

            <h3 class="text-[17px] font-semibold text-black mb-3">Key Features</h3>
            <ul class="space-y-2 mb-8">
              <li class="flex items-start gap-2 text-[13px] text-mid-gray leading-[1.7]">
                <span class="text-accent mt-1">•</span> Park-like campus with pond, fountain, and walking paths
              </li>
              <li class="flex items-start gap-2 text-[13px] text-mid-gray leading-[1.7]">
                <span class="text-accent mt-1">•</span> Flexible office suites from 1,000 to 15,000+ SF
              </li>
              <li class="flex items-start gap-2 text-[13px] text-mid-gray leading-[1.7]">
                <span class="text-accent mt-1">•</span> Convenient West Side location with easy highway access
              </li>
              <li class="flex items-start gap-2 text-[13px] text-mid-gray leading-[1.7]">
                <span class="text-accent mt-1">•</span> Ample surface parking, on-site property management
              </li>
              <li class="flex items-start gap-2 text-[13px] text-mid-gray leading-[1.7]">
                <span class="text-accent mt-1">•</span> Professional tenant mix including financial services, healthcare, and tech
              </li>
            </ul>

            <!-- Photo Gallery -->
            <PropertyGallery images={[
              { src: '/images/properties/honey-creek/front-parking.jpg', alt: 'Honey Creek front entrance' },
              { src: '/images/properties/honey-creek/building-sign.jpg', alt: 'Honey Creek building sign' },
              { src: '/images/properties/honey-creek/pond-fountain.jpg', alt: 'Honey Creek pond and fountain' },
              { src: '/images/properties/honey-creek/pond-chairs.jpg', alt: 'Honey Creek pond seating area' },
            ]} />

            <!-- Map -->
            <PropertyMap lat={43.0435} lng={-89.4960} label="Honey Creek Corporate Center" />
          </div>

          <div>
            <LeadCaptureForm
              context="Property Inquiry – Honey Creek Corporate Center"
              heading="Inquire About This Property"
              subheading="Interested in leasing space or learning more? Let us know."
            />
          </div>

        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
