---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import LeadCaptureForm from '../../components/LeadCaptureForm.astro';
---

<Layout title="Residential Property Management – Blackdeer Investment Group">
  <Nav />

  <main class="pt-[68px]">
    <!-- Hero Banner -->
    <section class="bg-black py-20">
      <div class="max-w-[1280px] mx-auto px-10">
        <div class="label">Services</div>
        <h1 class="text-[clamp(32px,4vw,48px)] font-bold text-white tracking-tight leading-tight">Residential Property Management</h1>
        <p class="text-[15px] text-[#aaa] mt-4 max-w-[640px] leading-[1.8]">Full-service residential operations for multifamily and single-family portfolios — from lease-up through stabilization and value-add repositioning.</p>
      </div>
    </section>

    <!-- Content -->
    <section class="bg-white py-20 border-t border-border">
      <div class="max-w-[1280px] mx-auto px-10">
        <div class="col-2 grid grid-cols-2 gap-16 items-start">

          <div>
            <div class="accent-rule"></div>
            <h2 class="text-[24px] font-bold text-black mb-4">What We Deliver</h2>
            <p class="text-[14px] text-mid-gray leading-[1.8] mb-6">Our residential division manages the full lifecycle of multifamily and rental assets. We combine resident satisfaction with owner returns through proactive management and value-add strategies.</p>

            <div class="space-y-5">
              <div class="flex gap-4 items-start">
                <div class="w-8 h-8 bg-accent/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                  <span class="text-accent font-bold text-sm">1</span>
                </div>
                <div>
                  <h3 class="text-[15px] font-semibold text-black mb-1">Leasing & Resident Relations</h3>
                  <p class="text-[13px] text-mid-gray leading-[1.7]">Marketing vacant units, screening applicants, executing leases, handling renewals, and maintaining positive resident relationships that reduce turnover.</p>
                </div>
              </div>

              <div class="flex gap-4 items-start">
                <div class="w-8 h-8 bg-accent/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                  <span class="text-accent font-bold text-sm">2</span>
                </div>
                <div>
                  <h3 class="text-[15px] font-semibold text-black mb-1">Rent Collection & Financial Reporting</h3>
                  <p class="text-[13px] text-mid-gray leading-[1.7]">Online rent payment processing, delinquency management, monthly financial statements, and annual budgeting for consistent cash flow.</p>
                </div>
              </div>

              <div class="flex gap-4 items-start">
                <div class="w-8 h-8 bg-accent/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                  <span class="text-accent font-bold text-sm">3</span>
                </div>
                <div>
                  <h3 class="text-[15px] font-semibold text-black mb-1">Maintenance & Vendor Management</h3>
                  <p class="text-[13px] text-mid-gray leading-[1.7]">24/7 maintenance request handling, preventive maintenance schedules, vendor procurement, and turn coordination for quick unit readiness.</p>
                </div>
              </div>

              <div class="flex gap-4 items-start">
                <div class="w-8 h-8 bg-accent/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                  <span class="text-accent font-bold text-sm">4</span>
                </div>
                <div>
                  <h3 class="text-[15px] font-semibold text-black mb-1">Value-Add Strategy</h3>
                  <p class="text-[13px] text-mid-gray leading-[1.7]">Unit renovation planning, amenity upgrades, rent optimization, and repositioning strategies that increase property value and investor returns.</p>
                </div>
              </div>
            </div>

            <div class="mt-10 p-6 bg-off-white border border-border">
              <h3 class="text-[14px] font-semibold text-black mb-2">Our Track Record</h3>
              <p class="text-[13px] text-mid-gray leading-[1.7]">Managing 200+ residential units across Wisconsin, including Station 955 luxury apartments in Eau Claire and multiple multifamily communities in the Madison area.</p>
            </div>
          </div>

          <div>
            <LeadCaptureForm
              context="Residential Property Management"
              heading="Request a Management Proposal"
              subheading="Tell us about your residential portfolio and we'll build a management plan that fits."
            />
          </div>

        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
