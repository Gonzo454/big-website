---
---

<header id="nav" class="fixed top-0 left-0 right-0 z-100 bg-white border-b border-border transition-all duration-300">
  <div class="max-w-[1280px] mx-auto px-10 h-[68px] flex items-center justify-between">

    <!-- Logo + wordmark -->
    <a href="#" class="flex items-center gap-3.5 no-underline">
      <img
        src="/images/logo.png"
        alt="Blackdeer"
        class="h-9 w-auto block"
        onerror="this.style.display='none';document.getElementById('logo-fallback').style.display='flex'"
      />
      <div id="logo-fallback" class="hidden w-9 h-9 bg-accent items-center justify-center font-bold text-[13px] text-white tracking-wide">B</div>
      <div>
        <div class="text-[15px] font-bold text-black tracking-[.06em] uppercase">Blackdeer</div>
        <div class="text-[10px] text-mid-gray tracking-[.1em] uppercase mt-px">Investment Group</div>
      </div>
    </a>

    <!-- Desktop nav -->
    <nav class="flex items-center gap-8 hide-m">
      <a href="#services" class="nav-link">Services</a>
      <a href="#properties" class="nav-link">Properties</a>
      <a href="#partners" class="nav-link">Partners</a>
      <a href="#team" class="nav-link">Team</a>
      <a href="#investors" class="nav-link">Investors</a>
      <a href="#contact" class="btn-accent">Get a Proposal</a>
    </nav>

    <!-- Hamburger -->
    <button id="hamburger" class="hidden p-2 bg-transparent border border-border cursor-pointer" aria-label="Menu">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </div>

  <!-- Mobile dropdown -->
  <div id="mobile-menu" class="flex-col bg-white border-t border-border px-6 py-4 gap-0.5">
    <a href="#services" class="nav-link block py-2.5 border-b border-border mobile-nav-link">Services</a>
    <a href="#properties" class="nav-link block py-2.5 border-b border-border mobile-nav-link">Properties</a>
    <a href="#partners" class="nav-link block py-2.5 border-b border-border mobile-nav-link">Partners</a>
    <a href="#team" class="nav-link block py-2.5 border-b border-border mobile-nav-link">Team</a>
    <a href="#investors" class="nav-link block py-2.5 border-b border-border mobile-nav-link">Investors</a>
    <a href="#contact" class="btn-accent mt-3 text-center mobile-nav-link">Get a Proposal</a>
  </div>
</header>

<script>
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');
  const desktopNav = document.querySelectorAll('.hide-m');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  function checkMobile() {
    if (window.innerWidth < 900) {
      desktopNav.forEach(el => (el as HTMLElement).style.display = 'none');
      if (hamburger) (hamburger as HTMLElement).style.display = 'flex';
    } else {
      desktopNav.forEach(el => (el as HTMLElement).style.display = '');
      if (hamburger) (hamburger as HTMLElement).style.display = 'none';
      mobileMenu?.classList.remove('open');
    }
  }

  function toggleMenu() {
    mobileMenu?.classList.toggle('open');
  }

  window.addEventListener('resize', checkMobile);
  checkMobile();

  hamburger?.addEventListener('click', toggleMenu);
  mobileLinks.forEach(link => link.addEventListener('click', toggleMenu));

  // Smooth scroll
  document.querySelectorAll('a[href^="#"]').forEach(a => {
    a.addEventListener('click', (e) => {
      const id = a.getAttribute('href');
      if (id === '#') return;
      const el = document.querySelector(id!);
      if (el) { e.preventDefault(); el.scrollIntoView({ behavior: 'smooth' }); }
    });
  });
</script>
