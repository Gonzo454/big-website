---
const services = [
  'Accounting & Reporting',
  'Leasing Only',
  'Maintenance Coordination',
  'Vendor Management',
  'Capital Project Oversight',
  'Financial Reporting Only',
  'Rent Collection',
  'Full-Service Management',
  'Bank Receivership',
  'Budgeting Support',
];
---

<section id="contact" class="bg-white py-20 border-t border-border">
  <div class="max-w-[1280px] mx-auto px-10">
    <div class="mb-12">
      <div class="label">Proposal Builder</div>
      <h2 class="text-[clamp(26px,3vw,38px)] font-bold text-black tracking-tight">Build Your Management Plan</h2>
      <p class="text-sm text-mid-gray mt-2.5 max-w-[480px] leading-[1.7]">Select the services you need — no full-service package required.</p>
    </div>

    <div class="col-2 grid grid-cols-2 gap-10 items-start">

      <!-- Checkboxes -->
      <div>
        <div class="text-[11px] font-semibold tracking-[.16em] uppercase text-mid-gray mb-4">Select Your Services</div>
        <div class="col-2-sm grid grid-cols-2 gap-2">
          {services.map(service => (
            <label class="card flex items-center gap-2.5 p-3 cursor-pointer text-xs text-black">
              <input type="checkbox" name="services" value={service} form="proposal-form" class="plan-check" /> {service}
            </label>
          ))}
        </div>
        <p class="text-[11px] text-[#aaa] mt-3.5">Select services, fill out the form, and we'll be in touch within one business day.</p>
      </div>

      <!-- Form -->
      <form id="proposal-form" class="bg-black p-9" action="https://formspree.io/f/maqgngya" method="POST">
        <input type="hidden" name="_cc" value="andrea@blackdeerig.com,sienna@blackdeerig.com,chad@blackdeerig.com,ted@blackdeerig.com,joe@blackdeerig.com" />
        <input type="hidden" name="_subject" value="New Proposal Request" />
        <h3 class="text-[22px] font-bold text-white mb-1.5">Request a Proposal</h3>
        <p class="text-[13px] text-[#aaa] mb-7">Tell us about your property and goals.</p>

        <div class="flex flex-col gap-3.5">
          <div>
            <div class="text-[10px] tracking-[.14em] uppercase text-[#999] mb-1.5">Your Name</div>
            <input type="text" name="name" placeholder="Jane Smith" required class="form-input !bg-[#111] !border-[#333] !text-white" />
          </div>
          <div>
            <div class="text-[10px] tracking-[.14em] uppercase text-[#999] mb-1.5">Email Address</div>
            <input type="email" name="email" placeholder="jane@company.com" required class="form-input !bg-[#111] !border-[#333] !text-white" />
          </div>
          <div>
            <div class="text-[10px] tracking-[.14em] uppercase text-[#999] mb-1.5">Phone</div>
            <input type="tel" name="phone" placeholder="(608) 000-0000" class="form-input !bg-[#111] !border-[#333] !text-white" />
          </div>
          <div>
            <div class="text-[10px] tracking-[.14em] uppercase text-[#999] mb-1.5">Property Type</div>
            <select name="property_type" class="form-input !bg-[#111] !border-[#333] !text-white">
              <option value="">Select type…</option>
              <option>Commercial Office</option>
              <option>Retail</option>
              <option>Industrial</option>
              <option>Multifamily / Residential</option>
              <option>Senior Housing</option>
              <option>Mixed Use</option>
              <option>Other</option>
            </select>
          </div>
          <div>
            <div class="text-[10px] tracking-[.14em] uppercase text-[#999] mb-1.5">Tell Us About Your Property</div>
            <textarea name="message" rows="3" placeholder="Location, size, current situation, goals…" class="form-input !bg-[#111] !border-[#333] !text-white resize-y"></textarea>
          </div>
          <button type="submit" class="btn-accent w-full py-3.5 text-center">Send Request →</button>
        </div>
      </form>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('proposal-form') as HTMLFormElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form!.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalText = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Sending…';

    const data = new FormData(form!);
    const services = data.getAll('services');
    if (services.length) {
      data.set('services_selected', services.join(', '));
    }

    try {
      const res = await fetch(form!.action, {
        method: 'POST',
        body: data,
        headers: { 'Accept': 'application/json' },
      });

      if (res.ok) {
        alert('Thank you! Your inquiry has been received. A Blackdeer team member will contact you within one business day.');
        form!.reset();
      } else {
        alert('Something went wrong. Please try again or call us at (877) 271-4707.');
      }
    } catch {
      alert('Network error. Please try again or call us at (877) 271-4707.');
    } finally {
      btn.disabled = false;
      btn.textContent = originalText;
    }
  });
</script>
