---
const services = [
  'Accounting & Reporting',
  'Leasing Only',
  'Maintenance Coordination',
  'Vendor Management',
  'Capital Project Oversight',
  'Financial Reporting Only',
  'Rent Collection',
  'Full-Service Management',
  'Bank Receivership',
  'Budgeting Support',
];
---

<section id="contact" class="bg-white py-20 border-t border-border">
  <div class="max-w-[1280px] mx-auto px-10">
    <div class="mb-12">
      <div class="label">Lead Generation</div>
      <h2 class="text-[clamp(26px,3vw,38px)] font-bold text-black tracking-tight">Build Your Management Plan</h2>
      <p class="text-sm text-mid-gray mt-2.5 max-w-[480px] leading-[1.7]">Select the services you need — no full-service package required.</p>
    </div>

    <div class="col-2 grid grid-cols-2 gap-10 items-start">

      <!-- Checkboxes -->
      <div>
        <div class="text-[11px] font-semibold tracking-[.16em] uppercase text-mid-gray mb-4">Select Your Services</div>
        <div class="col-2-sm grid grid-cols-2 gap-2">
          {services.map(service => (
            <label class="card flex items-center gap-2.5 p-3 cursor-pointer text-xs text-black">
              <input type="checkbox" class="plan-check" /> {service}
            </label>
          ))}
        </div>
        <p class="text-[11px] text-[#aaa] mt-3.5">Select services, fill out the form, and we'll be in touch within one business day.</p>
      </div>

      <!-- Form -->
      <div class="bg-black p-9">
        <h3 class="text-[22px] font-bold text-white mb-1.5">Request a Proposal</h3>
        <p class="text-[13px] text-[#666] mb-7">Tell us about your property and goals.</p>

        <div class="flex flex-col gap-3.5">
          <div>
            <div class="text-[10px] tracking-[.14em] uppercase text-[#555] mb-1.5">Your Name</div>
            <input type="text" placeholder="Jane Smith" class="form-input !bg-[#111] !border-[#333] !text-white" />
          </div>
          <div>
            <div class="text-[10px] tracking-[.14em] uppercase text-[#555] mb-1.5">Email Address</div>
            <input type="email" placeholder="jane@company.com" class="form-input !bg-[#111] !border-[#333] !text-white" />
          </div>
          <div>
            <div class="text-[10px] tracking-[.14em] uppercase text-[#555] mb-1.5">Phone</div>
            <input type="tel" placeholder="(608) 000-0000" class="form-input !bg-[#111] !border-[#333] !text-white" />
          </div>
          <div>
            <div class="text-[10px] tracking-[.14em] uppercase text-[#555] mb-1.5">Property Type</div>
            <select class="form-input !bg-[#111] !border-[#333] !text-white">
              <option value="">Select type…</option>
              <option>Commercial Office</option>
              <option>Retail</option>
              <option>Industrial</option>
              <option>Multifamily / Residential</option>
              <option>Senior Housing</option>
              <option>Mixed Use</option>
              <option>Other</option>
            </select>
          </div>
          <div>
            <div class="text-[10px] tracking-[.14em] uppercase text-[#555] mb-1.5">Tell Us About Your Property</div>
            <textarea rows="3" placeholder="Location, size, current situation, goals…" class="form-input !bg-[#111] !border-[#333] !text-white resize-y"></textarea>
          </div>
          <button id="submit-btn" class="btn-accent w-full py-3.5 text-center">Send Request →</button>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  document.getElementById('submit-btn')?.addEventListener('click', () => {
    alert('Thank you! A Blackdeer team member will contact you within one business day.');
  });
</script>
