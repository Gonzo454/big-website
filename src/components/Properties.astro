---
const properties = [
  {
    image: '/images/properties/honey-creek/panoramic.jpg',
    alt: 'Honey Creek Corporate Center',
    tag: 'Commercial · Managed',
    name: 'Honey Creek Corporate Center',
    location: 'Madison, WI',
    href: '/properties/honey-creek-corporate-center',
  },
  {
    image: '/images/properties/cottage-grove-retail/aerial-1.png',
    alt: 'Cottage Grove Retail Center',
    tag: 'Retail · Managed',
    name: 'Cottage Grove Retail Center',
    location: 'Cottage Grove, WI',
    href: '/properties/cottage-grove-retail-center',
  },
  {
    image: '/images/properties/cic-ii/exterior-1.png',
    alt: 'Center for Industry and Commerce II',
    tag: 'Industrial · Managed',
    name: 'Center for Industry & Commerce II',
    location: 'Madison, WI',
    href: '/properties/center-for-industry-and-commerce-ii',
  },
  {
    image: '/images/properties/955/exterior-front.jpg',
    alt: 'Station 955',
    tag: 'Development · Completed',
    name: 'Station 955 – Luxury Apartments',
    location: 'Eau Claire, WI',
    href: '/properties/station-955',
  },
];
---

<section id="properties" class="bg-off-white py-20 border-t border-border">
  <div class="max-w-[1280px] mx-auto px-10">
    <div class="flex justify-between items-end mb-10 flex-wrap gap-4">
      <div>
        <div class="label">Portfolio</div>
        <h2 class="text-[clamp(26px,3vw,38px)] font-bold text-black tracking-tight">Featured Properties &amp; Transactions</h2>
      </div>
      <a href="#" class="text-[11px] tracking-[.12em] uppercase text-accent no-underline font-semibold">View All →</a>
    </div>

    <div class="col-4 grid grid-cols-4 gap-4">
      {properties.map(property => (
        <a href={property.href} class="card overflow-hidden no-underline block">
          <div class="h-[180px] bg-light-gray overflow-hidden">
            <img
              src={property.image}
              alt={property.alt}
              class="w-full h-full object-cover block"
              onerror="this.parentElement.style.background='#ddd'"
            />
          </div>
          <div class="p-4.5 px-4">
            <div class="tag mb-2">{property.tag}</div>
            <div class="text-sm font-semibold text-black leading-tight mt-1.5">{property.name}</div>
            <div class="text-[11px] text-mid-gray mt-1">{property.location}</div>
            <span class="text-[11px] tracking-[.1em] uppercase text-accent font-semibold mt-2 inline-block">View Details →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
