---
const team = [
  {
    image: '/images/team/joe-wagner.png',
    alt: 'Joe Wagner',
    name: 'Joe Wagner',
    role: 'Founder · CEO',
    phone: '(608) 555-0000',
    email: 'info@blackdeerig.com',
    focus: 'Leadership · Investment · Development',
  },
  {
    image: '/images/team/denise-wagner.png',
    alt: 'Denise Wagner',
    name: 'Denise Wagner',
    role: 'Founder · Board Member',
    phone: '(608) 555-0001',
    email: 'info@blackdeerig.com',
    focus: 'Strategy · Governance · Operations',
  },
  {
    image: '/images/team/kevin-bale.jpg',
    alt: 'Kevin Bale',
    name: 'Kevin Bale',
    role: 'Operations Manager',
    phone: '(608) 555-0002',
    email: 'info@blackdeerig.com',
    focus: 'Property Operations · Maintenance · Logistics',
  },
  {
    image: '/images/team/carrie-stanke.png',
    alt: 'Carrie Stanke',
    name: 'Carrie Stanke',
    role: 'Accounting Manager',
    phone: '(608) 555-0003',
    email: 'info@blackdeerig.com',
    focus: 'Accounting · Finance · Reporting',
  },
];
---

<section id="team" class="bg-off-white py-20 border-t border-border">
  <div class="max-w-[1280px] mx-auto px-10">
    <div class="mb-12">
      <div class="label">The People</div>
      <h2 class="text-[clamp(26px,3vw,38px)] font-bold text-black tracking-tight">Our Team</h2>
      <p class="text-sm text-mid-gray mt-2.5 max-w-[480px] leading-[1.7]">Experienced professionals across management, development, brokerage, and operations.</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {team.map(member => (
        <div class="card overflow-hidden">
          <div class="h-[260px] bg-[#1a1a1a] overflow-hidden">
            <img
              src={member.image}
              alt={member.alt}
              class="w-full h-full object-cover object-[center_20%] block"
            />
          </div>
          <div class="p-5 border-t-2 border-accent">
            <div class="text-base font-semibold text-black">{member.name}</div>
            <div class="text-[10px] font-semibold tracking-[.14em] uppercase text-accent my-1.5 mb-3">{member.role}</div>
            <div class="text-xs text-mid-gray">{member.phone}</div>
            <a href={`mailto:${member.email}`} class="text-xs text-accent no-underline">{member.email}</a>
            <div class="mt-3 pt-3 border-t border-border text-[11px] text-[#aaa]">{member.focus}</div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
