---
---

<!-- Hero -->
<section id="hero" class="bg-white min-h-[80vh] flex flex-col justify-center pt-[68px] border-b border-border">
  <div class="max-w-[1280px] mx-auto px-10 py-20 w-full">

    <!-- Eyebrow -->
    <div class="label fade-up">Madison, Wisconsin · Midwest Focused</div>

    <!-- Headline -->
    <h1 class="fade-up-2 text-[clamp(44px,6vw,76px)] font-bold text-black leading-[1.05] tracking-tight max-w-[780px] mb-6">
      Full-Service<br/>Real Estate.
    </h1>

    <p class="fade-up-3 text-base text-mid-gray max-w-[520px] leading-[1.8] mb-4">
      Commercial &amp; Residential Property Management · Development · Brokerage · Investment Opportunities
    </p>
    <p class="fade-up-3 text-[13px] text-[#aaa] mb-11">Blackdeer Investment Group · Cottage Grove, WI</p>

    <!-- CTAs -->
    <div class="fade-up-4 flex gap-3 flex-wrap">
      <a href="#contact" class="btn-accent">Request a Proposal</a>
      <a href="#services" class="btn-outline-dark">Our Services</a>
      <a href="#investors" class="btn-outline-dark">Investor Portal</a>
    </div>

    <!-- Stats bar -->
    <div class="fade-up-4 mt-18 pt-9 border-t border-border grid grid-cols-4 gap-8 max-w-[640px]">
      <div>
        <div class="stat-num">15+</div>
        <div class="text-[10px] tracking-[.12em] uppercase text-[#aaa] mt-1.5">Years Experience</div>
      </div>
      <div>
        <div class="stat-num">$100M+</div>
        <div class="text-[10px] tracking-[.12em] uppercase text-[#aaa] mt-1.5">Assets Managed</div>
      </div>
      <div>
        <div class="stat-num">5</div>
        <div class="text-[10px] tracking-[.12em] uppercase text-[#aaa] mt-1.5">Service Lines</div>
      </div>
      <div>
        <div class="stat-num text-xl">Midwest</div>
        <div class="text-[10px] tracking-[.12em] uppercase text-[#aaa] mt-1.5">Region Focus</div>
      </div>
    </div>
  </div>
</section>

<!-- About Strip -->
<section class="bg-off-white border-t border-border py-20">
  <div class="max-w-[1280px] mx-auto px-10 grid gap-15 items-center grid-cols-[1fr_2fr] col-2">
    <div>
      <div class="label">About BIG</div>
      <h2 class="text-[clamp(28px,3.5vw,42px)] font-bold text-black leading-[1.15] tracking-tight">More than investors.<br/>We are operators.</h2>
    </div>
    <div>
      <div class="accent-rule"></div>
      <p class="text-[15px] text-mid-gray leading-[1.85] mb-4">Blackdeer Investment Group is a Midwest-focused, full-service real estate company headquartered in Cottage Grove, Wisconsin. We bring commercial property management, residential management, development, brokerage, and investment expertise under one experienced team.</p>
      <p class="text-[15px] text-mid-gray leading-[1.85]">Our third-party property management division is growing rapidly — because owners trust us to manage their assets with an owner's mindset: protecting value, maximizing income, and communicating clearly every step of the way.</p>
    </div>
  </div>
</section>
