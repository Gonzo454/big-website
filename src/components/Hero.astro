---
---

<!-- Hero -->
<section id="hero" class="relative pt-[68px] border-b border-border overflow-hidden">
  <!-- Background image -->
  <div class="absolute inset-0">
    <img src="/images/hero/madison-skyline.png" alt="" class="w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/60"></div>
  </div>

  <div class="relative max-w-[1280px] mx-auto px-10 pt-16 pb-20 w-full text-center">

    <!-- Eyebrow -->
    <div class="fade-up flex items-center justify-center gap-3 text-[10px] tracking-[.18em] uppercase font-semibold !text-[#E07B2A] mb-3.5">
      <span class="w-6 h-px bg-[#E07B2A]"></span>
      Madison, Wisconsin · Midwest Focused
      <span class="w-6 h-px bg-[#E07B2A]"></span>
    </div>

    <!-- Headline -->
    <h1 class="fade-up-2 text-[clamp(44px,6vw,76px)] font-bold text-white leading-[1.05] tracking-tight mx-auto mb-6">
      Full-Service<br/>Real Estate Solutions
    </h1>

    <p class="fade-up-3 text-base text-white leading-[1.8] mb-4">
      Commercial &amp; Residential Property Management · Development · Brokerage · Investment Opportunities
    </p>
    <p class="fade-up-3 text-[13px] text-white/80 mb-11">Blackdeer Investment Group · Cottage Grove, WI</p>

    <!-- CTAs -->
    <div class="fade-up-4 flex gap-3 flex-wrap justify-center">
      <a href="#contact" class="btn-accent">Request a Proposal</a>
      <a href="#services" class="btn-outline-hero">Our Services</a>
      <a href="#investors" class="btn-outline-hero">Investor Portal</a>
    </div>

    <!-- Stats bar -->
    <div class="fade-up-4 mt-18 pt-9 border-t border-white/20 grid grid-cols-4 gap-8 max-w-[640px] mx-auto">
      <div>
        <div class="stat-num !text-[#E07B2A]">25+</div>
        <div class="text-[10px] tracking-[.12em] uppercase text-white/70 mt-1.5">Years Experience</div>
      </div>
      <div>
        <div class="stat-num !text-[#E07B2A]">$300M+</div>
        <div class="text-[10px] tracking-[.12em] uppercase text-white/70 mt-1.5">Assets Managed</div>
      </div>
      <div>
        <div class="stat-num !text-[#E07B2A]">5</div>
        <div class="text-[10px] tracking-[.12em] uppercase text-white/70 mt-1.5">Service Lines</div>
      </div>
      <div>
        <div class="stat-num text-xl !text-[#E07B2A]">Midwest</div>
        <div class="text-[10px] tracking-[.12em] uppercase text-white/70 mt-1.5">Region Focus</div>
      </div>
    </div>
  </div>
</section>

<!-- About Strip -->
<section class="bg-off-white border-t border-border py-20">
  <div class="max-w-[1280px] mx-auto px-10 grid gap-15 items-center grid-cols-[1fr_2fr] col-2">
    <div>
      <div class="label">About BIG</div>
      <h2 class="text-[clamp(28px,3.5vw,42px)] font-bold text-black leading-[1.15] tracking-tight">More than investors.<br/>We are operators.</h2>
    </div>
    <div>
      <div class="accent-rule"></div>
      <p class="text-[15px] text-mid-gray leading-[1.85] mb-4">Blackdeer Investment Group is a Midwest-focused, full-service real estate company headquartered in Cottage Grove, Wisconsin. We bring commercial property management, residential management, development, brokerage, and investment expertise under one experienced team.</p>
      <p class="text-[15px] text-mid-gray leading-[1.85]">Our third-party property management division is growing rapidly — because owners trust us to manage their assets with an owner's mindset: protecting value, maximizing income, and communicating clearly every step of the way.</p>
    </div>
  </div>
</section>
