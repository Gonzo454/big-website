---
const partners = [
  {
    logo: '/images/logos/y-realty-logo-white.png',
    name: 'Badger Realty Partnered with Y',
    url: 'https://yrealtyinc.com/',
    role: 'Residential Sales Partner',
    desc: 'Home buying, selling, and residential advisory. Badger Realty partnered with Y operates as a residential sales and referral partner — separate from Blackdeer\'s property management division.',
    tags: ['Home Buying', 'Home Selling', 'Residential Advisory'],
  },
  {
    logo: '/images/logos/park-vista-logo.png',
    name: 'Park Vista Senior Housing',
    url: 'https://parkvistaliving.org/',
    role: 'Senior Housing Operations Partner',
    desc: 'Focused exclusively on senior living operations, assisted living, memory care, and senior housing property management — a specialized partner associated with Blackdeer.',
    tags: ['Senior Living', 'Assisted Living', 'Memory Care'],
  },
  {
    logo: '/images/logos/metify-logo-white.png',
    name: 'Metify',
    url: 'https://www.metify.ai',
    role: 'Technology Partner',
    desc: 'Providing cutting-edge technology solutions and digital infrastructure to streamline operations, enhance data management, and drive innovation across the Blackdeer portfolio.',
    tags: ['Data Center Automation', 'AI-Ready Buildings', 'AI Consultancy'],
  },
];
---

<section id="partners" class="bg-white py-20 border-t border-border">
  <div class="max-w-[1280px] mx-auto px-10">
    <div class="mb-12">
      <div class="label">Network</div>
      <h2 class="text-[clamp(26px,3vw,38px)] font-bold text-black tracking-tight">Our Strategic Partners</h2>
      <p class="text-sm text-mid-gray mt-2.5 max-w-[480px] leading-[1.7]">Specialized partners expand our service coverage while keeping each relationship clear and transparent.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-[1280px]">
      {partners.map(partner => (
        <a href={partner.url} target="_blank" rel="noopener noreferrer" class="card p-8 flex gap-5 items-start no-underline hover:border-accent transition-colors">
          <div class="w-12 h-12 bg-black shrink-0 flex items-center justify-center rounded">
            <img src={partner.logo} alt={partner.name} class="w-10 h-10 object-contain" />
          </div>
          <div>
            <h3 class="text-base font-semibold text-black">{partner.name}</h3>
            <div class="text-[10px] font-semibold tracking-[.14em] uppercase text-accent my-1 mb-2.5">{partner.role}</div>
            <p class="text-[13px] text-mid-gray leading-[1.75] mb-3">{partner.desc}</p>
            <div class="flex flex-wrap gap-1.5">
              {partner.tags.map(tag => <span class="tag">{tag}</span>)}
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
